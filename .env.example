# Dev mode:
# - local: Android emulator -> 10.0.2.2, iOS simulator -> localhost
# - deploy: call EXPO_PUBLIC_API_SERVER in dev
EXPO_PUBLIC_API_ENV=local

# Deploy URL (also used by release build)
EXPO_PUBLIC_API_SERVER=https://edubridgehcm.onrender.com

# Optional: set when testing on physical device (use your LAN IP)
# EXPO_PUBLIC_API_LOCAL=http://192.168.1.10:8080

# Optional: hard override all logic above
# EXPO_PUBLIC_API_BASE=

# EmailJS — gửi email sau khi phụ huynh xác nhận nhập học (đơn giữ chỗ)
# Bật "Allow EmailJS API for non-browser applications" trên dashboard EmailJS.
# EXPO_PUBLIC_EMAILJS_SERVICE_ID / PUBLIC_KEY / PRIVATE_KEY = bộ key trên web (WELCOME_* + private key).
# Private Key lấy tại EmailJS → Account → API keys (dùng accessToken khi strict mode).
EXPO_PUBLIC_EMAILJS_CONFIRM_ENROLLMENT_TEMPLATE_ID=template_rvdxbzh
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=
EXPO_PUBLIC_EMAILJS_PRIVATE_KEY=
